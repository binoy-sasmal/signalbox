#!/bin/sh
# Fast feedback only. The enforced gate is .github/workflows/secrets-check.yml,
# because --no-verify bypasses this hook.
#
# Enable once per clone:
#   git config core.hooksPath .githooks

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

if command -v py >/dev/null 2>&1; then
    PY="py -3"
elif command -v python3 >/dev/null 2>&1; then
    PY="python3"
else
    PY="python"
fi

# shellcheck disable=SC2086
echo "$staged" | xargs $PY scripts/probe/check_no_secrets.py
